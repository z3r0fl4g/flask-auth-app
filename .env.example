# Flask Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=development
# Generate a secure secret key: python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For development with PostgreSQL:
# DATABASE_URL=postgresql://tikepam_user:your_password@localhost:5432/tikepam_dev

# For production:
# DATABASE_URL=postgresql://user:password@db-host:5432/tikepam_prod

# Connection pool settings (production)
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20

# ============================================
# REDIS CONFIGURATION
# ============================================
# For local development:
REDIS_URL=redis://localhost:6379/0

# For production (with authentication):
# REDIS_URL=redis://:password@redis-host:6379/0

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Development - Vue.js dev server
FRONTEND_URL=http://localhost:5173

# Production - Your actual frontend domain
# FRONTEND_URL=https://yourdomain.com

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Production CORS (specific domain only)
# CORS_ORIGINS=https://yourdomain.com

# Session cookie domain (production only)
# SESSION_COOKIE_DOMAIN=.yourdomain.com

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Gmail SMTP (development/small scale)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Production SMTP (SendGrid example)
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# ============================================
# OAUTH PROVIDER CREDENTIALS
# ============================================

# Google OAuth
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# Get credentials: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Instagram OAuth
# Get credentials: https://developers.facebook.com/apps
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Twitter/X OAuth
# Get credentials: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ============================================
# TWILIO CONFIGURATION (Optional - for SMS)
# ============================================
# Get credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
# Sentry error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# ============================================
# NOTES
# ============================================
# 1. Never commit your .env file to version control
# 2. Use strong, unique passwords for database and Redis
# 3. Generate a new FLASK_SECRET_KEY for each environment
# 4. In production, use environment variables from your hosting platform
# 5. For Docker, create a separate .env file for docker-compose
